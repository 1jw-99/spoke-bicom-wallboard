# Copy to .env and fill in. Never commit .env.

# Where the data comes from: "pbxware7" (live) or "mock" (sample data for demos/dev)
WALLBOARD_SOURCE=pbxware7

# PBXware 7.6 API
# Base URL of the PBXware web interface (the API lives at /?apikey=...&action=...)
PBXWARE_URL=https://pbx.example.com
# Dedicated read-only API key (Admin Settings -> API Keys). Restrict it to this server's IP.
PBXWARE_API_KEY=change-me
# Set to "false" only if PBXware uses a self-signed certificate you cannot replace
PBXWARE_TLS_VERIFY=true
# Request timeout in milliseconds
PBXWARE_TIMEOUT_MS=8000

# Tenants to include: "all", or a comma-separated list of tenant (server) IDs
TENANTS=all
# Tenant IDs to always exclude (e.g. test tenants), comma-separated
TENANTS_EXCLUDE=

# Polling (seconds)
# Platform-wide data (live calls, dashboard counters, trunks, services)
POLL_PLATFORM_SECONDS=5
# Every tenant's extensions and counters are refreshed once per this many seconds,
# spread evenly so the PBX is never hit with a burst of requests
POLL_TENANT_CYCLE_SECONDS=120
# Call records for the "calls by hour" chart
POLL_CDR_SECONDS=60
# Optional: only ever feature these tenant IDs (comma-separated), in this order
FEATURED_TENANTS=
# Maximum PBXware requests in flight at once
PBXWARE_MAX_CONCURRENCY=2

# Web server
PORT=8080
HOST=127.0.0.1
# Basic auth for viewers (internal use). Leave both empty to disable (not recommended).
WALLBOARD_USER=spoke
WALLBOARD_PASSWORD=change-me
# Local time zone for "today" and the hourly chart
TIMEZONE=Europe/London
