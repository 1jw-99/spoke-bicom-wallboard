# systemd unit. Install:
#   sudo cp deploy/spoke-wallboard.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now spoke-wallboard
[Unit]
Description=Spoke Bicom wallboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wallboard
Group=wallboard
WorkingDirectory=/opt/spoke-bicom-wallboard
ExecStart=/usr/bin/node --max-old-space-size=192 src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# Memory guard rails: restart the wallboard rather than starve the server
MemoryHigh=300M
MemoryMax=400M
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/spoke-bicom-wallboard/probe-output

[Install]
WantedBy=multi-user.target
